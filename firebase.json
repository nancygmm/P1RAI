{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],

  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },

  "hosting": {
    "public": "public",

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "rewrites": [
      {
        "source": "/directorio",
        "function": {
          "functionId": "directorio",
          "region": "us-central1"
        }
      }
    ]
  },

  "emulators": {
    "functions": {
      "port": 5001
    },

    "firestore": {
      "port": 8080
    },

    "hosting": {
      "port": 5000
    },

    "ui": {
      "enabled": true,
      "port": 4000
    },

    "singleProjectMode": true
  }
}
